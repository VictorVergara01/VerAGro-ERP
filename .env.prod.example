# Plantilla de variables de PRODUCCIÓN. Copia a .env.prod y rellena.
#   Copy-Item .env.prod.example .env.prod   (PowerShell)
#   cp .env.prod.example .env.prod          (bash)
# .env.prod NO debe subirse al repo (está en .gitignore como .env.*).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production

# Clave secreta: generar una aleatoria y larga. Ejemplo para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CAMBIA-ESTO-por-una-clave-aleatoria-larga

# Hosts permitidos (el dominio del backend). Separa con coma si hay varios.
DJANGO_ALLOWED_HOSTS=api.tudominio.com

# Orígenes del panel web autorizados para CORS (con esquema https). Coma para varios.
CORS_ALLOWED_ORIGINS=https://erp.tudominio.com

# URL del backend que usa el panel web (se hornea en el build del contenedor `web`).
VITE_API_URL=https://api.tudominio.com

# Dirección de bind de los puertos del backend/web.
#  - 127.0.0.1 (default): solo accesibles localmente o por el cloudflared del stack.
#  - 0.0.0.0: accesibles desde la LAN, para un reverse proxy externo (Nginx Proxy Manager).
BIND_ADDR=127.0.0.1

# Token del Cloudflare Tunnel (Zero Trust → Networks → Tunnels → tu tunnel).
# SOLO si usas el túnel dedicado del stack (COMPOSE_PROFILES=tunnel). Es largo; pégalo
# con nano. No se versiona. Si publicas con NPM/reverse proxy externo, déjalo vacío.
TUNNEL_TOKEN=

# --- Opcionales de hardening (tienen default seguro; descomenta para ajustar) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.tudominio.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- PostgreSQL ---
DATABASE_NAME=veragro_erp
DATABASE_USER=veragro_user
DATABASE_PASSWORD=CAMBIA-ESTO-por-una-contrasena-fuerte
DATABASE_HOST=db
DATABASE_PORT=5432
