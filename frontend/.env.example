# Origen del backend (las rutas del OpenAPI ya incluyen el prefijo /api).
VITE_API_URL=http://localhost:8000

# (Opcional) URL de descarga del APK de la app de campo. Por defecto el botón
# "Descargar APK" del sidebar apunta a /downloads/veragro.apk (servido por el propio web;
# coloca el archivo en frontend/public/downloads/veragro.apk). Defínela solo si quieres otra
# URL, p. ej. el link directo de EAS Build.
# VITE_APK_URL=https://expo.dev/artifacts/eas/xxxxxxxx.apk
